# Konfigurasi Utama Gateway QRIS (qriskuu)
PORT=3000
API_KEY=ganti-dengan-string-acak-panjang          # Kunci akses API untuk toko Anda (X-API-Key atau ?api_key=)
ADMIN_PASSWORD=ganti-password-admin               # Password login portal /admin
ENCRYPTION_KEY=                                   # 64 hex char (opsional saat dev lokal): openssl rand -hex 32
WEBHOOK_SECRET=ganti-secret-webhook               # Tanda tangan HMAC-SHA256 untuk webhook

# Provider & QRIS
DEFAULT_PROVIDER=gopay                            # gopay | shopee | manual
QRIS_STATIC=                                      # Raw string QRIS statis toko Anda (00020101021126...)
SHOPEE_TOKEN=                                     # Token ShopeePay Merchant (opsional bila pakai Shopee)

# Penyimpanan Redis (Wajib untuk Vercel Serverless multi-instance, opsional untuk VPS/local)
UPSTASH_REDIS_REST_URL=                           # URL Upstash Redis REST
UPSTASH_REDIS_REST_TOKEN=                         # Token Upstash Redis REST

# Pengaturan Tambahan
BASE_URL=http://localhost:3000                    # Domain publik gateway Anda (untuk payment_link)
PAYMENT_EXPIRY_MINUTES=15                         # Masa berlaku QRIS dinamis (default: 15 menit)
MAX_UNIQUE_OFFSET=999                             # Batas maksimum kode unik acak (default: 999)
CRON_SECRET=                                      # Token otorisasi endpoint cron /api/cron/reconcile
